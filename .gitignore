# Local configuration
foundryconfig.json

# Distribution files
dist
.vitest

# ESLint
.eslintcache

# Junit results
junit.xml

# E2E test data (contains a copied Foundry license.json — must never be committed)
test-data/

# E2E local machine config (config.example.mjs is the committed template)
tests/e2e/config.mjs

# E2E ownership mutex (tests/e2e/support/spawn-lock.mjs); self-heals, safe to delete manually
.e2e-spawn.lock

# Crash leftover of the atomic fixture write (record-fixtures.mjs renames tmp over the target)
*.json.tmp
